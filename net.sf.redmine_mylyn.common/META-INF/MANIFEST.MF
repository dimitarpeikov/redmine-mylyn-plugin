Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %Bundle-Name
Bundle-SymbolicName: net.sf.redmine_mylyn.common;singleton:=true
Bundle-Version: 0.5.2.qualifier
Bundle-Vendor: %Bundle-Vendor
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-Activator: net.sf.redmine_mylyn.common.RedmineCommonPlugin
Export-Package: net.sf.redmine_mylyn.common.logging;x-friends:="net.sf.redmine_mylyn.api,net.sf.redmine_mylyn.core,net.sf.redmine_mylyn.ui"
Import-Package: org.eclipse.equinox.log;version="1.0.0"
Require-Bundle: org.eclipse.core.runtime;bundle-version="3.34.0",
 org.eclipse.osgi.services;bundle-version="3.12.300",
 ch.qos.logback.classic;bundle-version="1.5.18",
 ch.qos.logback.core;bundle-version="1.5.18",
 slf4j.api;bundle-version="2.0.17"
Service-Component: OSGI-INF/logServiceComponent.xml, OSGI-INF/logWriterComponent.xml
Bundle-ActivationPolicy: lazy
Bundle-Localization: plugin
